// Cloudflare Workers の設定。このサイトは「静的ファイルだけを配る Worker」として置く。
// Worker のコード(main)を持たないので、リクエストは全部 Cloudflare の静的配信が直接返す。
// 静的ファイルへのリクエストは無料で、回数の上限も無い。
//
//   go run ./cmd/build   # dist/ を書き出す
//   npx wrangler deploy  # dist/ を Cloudflare に上げる
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imutaro",
  // 実行環境の版を日付で固定する。上げるときは Cloudflare の変更履歴を見てから
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // apps.html を /apps で返し、/apps/ と /apps.html は /apps へ転送する(既定の挙動を明示)
    "html_handling": "auto-trailing-slash",
    // 無いパスには dist/404.html を 404 で返す
    "not_found_handling": "404-page"
  },
  // imutaro.com をこの Worker の独自ドメインにする。DNS レコードと証明書は Cloudflare が自動で作る。
  // 同じ名前の DNS レコードを手で作ってあると付けられない(code 100117)。
  // 2026-10-23 の切り替えでは、Vercel 向けの A レコードを消してから付けた。
  // www.imutaro.com → imutaro.com と uses.imutaro.com → /uses は、Cloudflare のリダイレクトルールで転送している
  "routes": [{ "pattern": "imutaro.com", "custom_domain": true }],
  // *.workers.dev の URL は使わない(本番と同じ中身が別の URL でも見えてしまうため)
  "workers_dev": false
}
