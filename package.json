{
  "name": "imutaro",
  "private": true,
  "description": "imutaro.com の e2e テストとデプロイの道具。サイト本体は Go で dist/ に書き出す(README を参照)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write 'web/**/*.{css,js}' 'e2e/**/*.ts' playwright.config.ts",
    "deploy": "wrangler deploy"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 100
  },
  "engines": {
    "node": ">=24.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "prettier": "^3.5.3",
    "wrangler": "4.149.0"
  }
}
